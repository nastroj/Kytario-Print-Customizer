# Application Base Path (e.g. / or /kytario-print-customizer/)
BASE_PATH=
BASE_URL=

# Port for local Express/Vite server (defaults to 3000)
PORT=3000

# Disable Vite HMR in container / sandbox environments
DISABLE_HMR=

# Optional custom proxy endpoint for external Kytario fetches when running in static environments
VITE_KYTARIO_PROXY_URL=